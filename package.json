{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js vite.config.ts eslint.config.js",
        "format": "prettier --write resources/js resources/css vite.config.ts tsconfig.json eslint.config.js package.json .prettierrc.json",
        "format:check": "prettier --check resources/js resources/css vite.config.ts tsconfig.json eslint.config.js package.json .prettierrc.json",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "^3.9.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.9.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.66.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0"
    },
    "name": "hris-lite",
    "overrides": {
        "minimatch": "^11.0.1"
    }
}
